# --- Base de datos ---
POSTGRES_USER=clouduser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=clouddb
DATABASE_URL=postgresql+asyncpg://clouduser:changeme@db:5432/clouddb

# --- Backend / Auth ---
SECRET_KEY=changeme_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_UPLOAD_CHUNK_SIZE=1048576

# --- Almacenamiento de archivos (Cloudflare R2, compatible con S3) ---
R2_ACCOUNT_ID=tu_account_id
R2_ACCESS_KEY_ID=tu_access_key_id
R2_SECRET_ACCESS_KEY=tu_secret_access_key
R2_BUCKET_NAME=cloud-storage

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
